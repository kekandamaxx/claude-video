{
  "name": "umpsa-timeout-edit",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion template for editing vertical 9:16 talking-head sports clips (TikTok / Instagram Reels); one composition per source video",
  "scripts": {
    "studio": "remotion studio",
    "preview": "scripts/render.sh ${COMP:-SemifinalEdit} preview",
    "render:final": "scripts/render.sh ${COMP:-SemifinalEdit} final",
    "stems": "scripts/stems.sh ${COMP:-SemifinalEdit}",
    "qa:faces": "python3 scripts/overlap_qa.py ${COMP:-SemifinalEdit}",
    "qa:audio": "scripts/stems.sh ${COMP:-SemifinalEdit} && python3 scripts/word_snr.py ${EDIT:-semifinal} ${COMP:-SemifinalEdit} && python3 scripts/audio_qa.py ${COMP:-SemifinalEdit}",
    "typecheck": "tsc --noEmit",
    "prepare:friendship": "scripts/prepare_friendship.sh",
    "qa:friendship": "esbuild scripts/friendship_qa.ts --bundle --platform=node --log-level=warning --loader:.css=empty --loader:.woff=empty --loader:.woff2=empty --outfile=out/.qa/friendship_qa.js && node out/.qa/friendship_qa.js",
    "render:friendship": "scripts/render_friendship.sh",
    "qa:capcut": "esbuild scripts/capcut_qa.ts --bundle --platform=node --log-level=warning --loader:.css=empty --loader:.woff=empty --loader:.woff2=empty --outfile=out/.qa/capcut_qa.js && node out/.qa/capcut_qa.js",
    "prepare:song": "scripts/prepare_song.sh",
    "render:capcut": "scripts/render_capcut.sh"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/montserrat": "5.3.0",
    "@remotion/cli": "4.0.540",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.540",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
